# Backend API base URL (used by the admin app).
# This must be publicly reachable from the instructor's browser so Stripe's
# OAuth callback (/api/instructor/stripe/return) can return to this app after
# the Connect authorization.
VITE_BACKEND_URL=http://localhost:4000

# Data source for the app:
#   DB      - read/write through the real backend (axios calls)
#   preview - read from local preview-data/db.json, no backend calls,
#             mutations are simulated and never sent to the server
VITE_DATA_MODE=DB
# VITE_DATA_MODE=preview
